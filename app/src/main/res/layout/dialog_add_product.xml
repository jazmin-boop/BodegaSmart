<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvAddDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo Producto"
                android:textColor="#081630"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="16dp"/>

            <!-- Barcode Field Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Código de Barras"
                android:textColor="#081630"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etBarcode"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:hint="Ej: 75010001"
                    android:textColor="#081630"
                    android:textColorHint="#79808F"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/btnScanDialogBarcode"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_add_btn_new"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Name Field Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Producto"
                android:textColor="#081630"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="16dp"
                android:hint="Ej: Arroz Costeño 1kg"
                android:textColor="#081630"
                android:textColorHint="#79808F"
                android:inputType="textPersonName"
                android:layout_marginTop="4dp" />

            <!-- Category Field Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="#081630"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="16dp"
                android:hint="Abarrotes, Frutas, Lácteos..."
                android:textColor="#081630"
                android:textColorHint="#79808F"
                android:inputType="text"
                android:layout_marginTop="4dp" />

            <!-- Prices Row Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Precio Venta (S/.)"
                    android:textColor="#081630"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Precio Costo (S/.)"
                    android:textColor="#081630"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etSalePrice"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:hint="0.00"
                    android:textColor="#081630"
                    android:textColorHint="#79808F"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/etCostPrice"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:hint="0.00"
                    android:textColor="#081630"
                    android:textColorHint="#79808F"
                    android:inputType="numberDecimal"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Stocks Row Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stock Actual"
                    android:textColor="#081630"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stock Mínimo"
                    android:textColor="#081630"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etStock"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:hint="10"
                    android:textColor="#081630"
                    android:textColorHint="#79808F"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/etMinStock"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:hint="5"
                    android:textColor="#081630"
                    android:textColorHint="#79808F"
                    android:inputType="number"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Expiration Date Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de Caducidad"
                android:textColor="#081630"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etExpirationDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="16dp"
                android:hint="Seleccionar fecha en calendario"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:textColor="#081630"
                android:textColorHint="#79808F"
                android:layout_marginTop="4dp" />

            <!-- Product Image Picker from Gallery -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Foto del Producto "
                android:textColor="#081630"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/imgProductPreview"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_search_bar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo"
                    android:padding="2dp" />

                <Button
                    android:id="@+id/btnPickImageGallery"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Seleccionar imagen"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#264653"
                    app:cornerRadius="23dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etImageUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Buttons inside White Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnCancelProduct"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    app:backgroundTint="#79808F"
                    app:cornerRadius="25dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnSaveProduct"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Guardar"
                    app:backgroundTint="#081630"
                    app:cornerRadius="25dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>