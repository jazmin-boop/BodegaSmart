<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar Cliente para Fiado"
                android:textColor="#081630"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExitCustomerSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="✕"
                android:textColor="#081630"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="4dp" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="El monto total de la venta se sumará a la deuda del cliente seleccionado:"
            android:textColor="#79808F"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCustomerSelectList"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>