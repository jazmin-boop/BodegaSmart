<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo2">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Exit Button -->
        <TextView
            android:id="@+id/btnExitInventory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="← Salir"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp" />

        <!-- Logo Image on Right Top (Circular Card Covering Entire Circle like Main) -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- White Rounded Content Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title "Catálogo de Productos" at Top -->
            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catálogo de Productos"
                android:textColor="#081630"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <!-- Row of Main Mode Buttons ABOVE Search Bar (Productos, Stock, Caducidad) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnProductsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Productos"
                    app:backgroundTint="#081630"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnFilterStock"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Stock"
                    app:backgroundTint="#E76F51"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnFilterExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Caducidad"
                    app:backgroundTint="#F4A261"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- Search Bar strictly saying "Buscar productos" -->
            <EditText
                android:id="@+id/etSearchInventory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Buscar productos"
                android:textColorHint="#79808F"
                android:textColor="#081630"
                android:paddingHorizontal="16dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Row BELOW Search Bar: Filter Buttons on Left, + Producto at Far Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnFilterCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Categoría"
                    app:backgroundTint="#264653"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnSubFilterStock"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Nivel Stock"
                    app:backgroundTint="#E76F51"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:visibility="gone"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnSubFilterCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Calendario"
                    app:backgroundTint="#2A9D8F"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:visibility="gone" />

                <!-- Flexible Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Far Right: + Producto Button -->
                <Button
                    android:id="@+id/btnAddProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="+ Producto"
                    app:backgroundTint="#081630"
                    app:cornerRadius="19dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>

            <!-- 2-Column Grid RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInventory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>