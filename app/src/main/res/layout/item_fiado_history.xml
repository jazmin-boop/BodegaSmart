<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#F8F9FA"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Date & Time + Debt Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="08/10/2026 - 11:08"
                android:textColor="#081630"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00"
                android:textColor="#E53935"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Product List (Each product on its own line) -->
        <TextView
            android:id="@+id/tvHistoryProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 2x Arroz Costeño\n• 1x Aceite Primor"
            android:textColor="#37474F"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp" />

        <!-- Status Badge (wrap_content) & Pay Button ("Pagar") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvHistoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deuda Pendiente"
                android:textColor="#D32F2F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_debt_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <!-- Spacer to push Pagar button to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnPayDebtItem"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Pagar"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="19dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>