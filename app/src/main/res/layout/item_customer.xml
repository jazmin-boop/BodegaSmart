<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Cliente"
                android:textColor="#081630"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustomerPhoneDni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tel: 987654321 | DNI: 12345678"
                android:textColor="#79808F"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvDebtAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deuda Total: S/ 0.00"
                android:textColor="#E53935"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvOverdueBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10 días sin abonar"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Action Container for Fiados Module Mode (Eye & WhatsApp) -->
        <LinearLayout
            android:id="@+id/llModuleActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnViewCustomerDetail"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_search_bar"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#081630"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnWhatsappCustomer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_whatsapp"
                android:scaleType="fitCenter"
                android:padding="1dp" />
        </LinearLayout>

        <!-- Action Button for Fiado Sale Selection Mode (Seleccionar) -->
        <Button
            android:id="@+id/btnSelectCustomerFiado"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Seleccionar"
            app:backgroundTint="#081630"
            app:cornerRadius="20dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>