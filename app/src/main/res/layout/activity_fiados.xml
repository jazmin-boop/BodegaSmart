<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo2">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Exit Button -->
        <TextView
            android:id="@+id/btnExitFiados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="← Salir"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp" />

        <!-- Logo Image on Right Top (Circular Card Covering Entire Circle like Main) -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="30dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- White Rounded Content Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- PANEL 1: LISTA DE CLIENTES -->
            <LinearLayout
                android:id="@+id/llCustomerListPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="visible">

                <!-- Title "Libreta de Fiados" -->
                <TextView
                    android:id="@+id/tvFiadosTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Libreta de Fiados"
                    android:textColor="#081630"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp" />

                <!-- Search Bar for Customers -->
                <EditText
                    android:id="@+id/etSearchCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="Buscar cliente por nombre o teléfono..."
                    android:textColorHint="#79808F"
                    android:textColor="#081630"
                    android:paddingHorizontal="16dp"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Row BELOW Search Bar with "+ Cliente" Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnAddCustomer"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:text="+ Cliente"
                        app:backgroundTint="#081630"
                        app:cornerRadius="20dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp" />
                </RelativeLayout>

                <!-- Customers RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCustomers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />

            </LinearLayout>

            <!-- PANEL 2: DETALLE DEL CLIENTE -->
            <LinearLayout
                android:id="@+id/llCustomerDetailPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Header Bar Detail Panel -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/btnBackToList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="← Volver a lista"
                        android:textColor="#081630"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:padding="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Detalle Cliente"
                        android:textColor="#79808F"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Customer Info Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_search_bar"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCustomerDetailName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nombre del Cliente"
                                android:textColor="#081630"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCustomerDetailPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teléfono / WhatsApp: 987654321"
                                android:textColor="#79808F"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvCustomerDetailDni"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DNI: 12345678"
                                android:textColor="#79808F"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#E0E0E0"
                                android:layout_marginVertical="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Deuda Total Acumulada:"
                                    android:textColor="#081630"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCustomerDetailDebt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="S/ 0.00"
                                    android:textColor="#E53935"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Action Buttons: Editar & Eliminar -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="16dp">

                                <Button
                                    android:id="@+id/btnEditCustomerDetail"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:text="Editar"
                                    app:backgroundTint="#081630"
                                    app:cornerRadius="22dp"
                                    android:textColor="@android:color/white"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="6dp" />

                                <Button
                                    android:id="@+id/btnDeleteCustomerDetail"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:text="Eliminar"
                                    app:backgroundTint="#E53935"
                                    app:cornerRadius="22dp"
                                    android:textColor="@android:color/white"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:layout_marginStart="6dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Section Title: Historial de Compras -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historial de Fiados / Compras"
                            android:textColor="#081630"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp" />

                        <!-- History RecyclerView inside ScrollView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCustomerPurchaseHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>